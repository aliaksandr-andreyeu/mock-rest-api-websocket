# HTTP server port
PORT=3000

# WebSocket push interval in milliseconds (50–60000)
WS_TICK_MS=1000

# WebSocket heartbeat / dead-connection ping interval in ms (1000–300000)
WS_HEARTBEAT_MS=30000

# Reject inbound WS frames larger than this many bytes (256–10485760)
WS_MAX_PAYLOAD_BYTES=65536

# Skip pushing events to a socket whose send buffer exceeds this (backpressure)
WS_MAX_BUFFERED_BYTES=1048576

# Max accepted upload size in bytes
UPLOAD_MAX_BYTES=5242880

# Rate limiting on /api (per IP). Set RATE_LIMIT_MAX=0 to disable.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=0

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Runtime environment: development | test | production
NODE_ENV=development

# Optional: seed faker for reproducible mock data (omit for random output)
# FAKER_SEED=12345
